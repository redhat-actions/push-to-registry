{
  "name": "push-to-registry",
  "version": "2.0.0",
  "private": true,
  "description": "Action to push images to registry",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/redhat-actions/push-to-registry.git"
  },
  "bugs": {
    "url": "https://github.com/redhat-actions/push-to-registry/issues"
  },
  "homepage": "https://github.com/redhat-actions/push-to-registry",
  "scripts": {
    "compile": "tsc -p .",
    "bundle": "ncc build src/index.ts --source-map --minify",
    "clean": "rm -rf out/ dist/",
    "lint": "eslint . --max-warnings=0",
    "generate-ios": "npx action-io-generator -w -o ./src/generated/inputs-outputs.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "Red Hat",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/io": "^3.0.2",
    "ini": "^5.0.0"
  },
  "devDependencies": {
    "@redhat-actions/action-io-generator": "^1.5.0",
    "@eslint/js": "^10.0.1",
    "@types/ini": "^4.1.1",
    "@types/node": "^22.0.0",
    "@vercel/ncc": "^0.44.1",
    "eslint": "^10.7.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
